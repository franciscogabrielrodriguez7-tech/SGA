# =============================================================================
# .env.docker.example — Plantilla de variables de entorno para Docker
# =============================================================================
#
# INSTRUCCIONES:
#   1. Copia este archivo: cp .env.docker.example .env.docker
#   2. Rellena los valores marcados como <CAMBIAR>.
#   3. Nunca subas .env.docker al repositorio (ya está en .gitignore).
#   4. Lanza el stack: docker compose --env-file .env.docker up --build -d
#
# =============================================================================


# -----------------------------------------------------------------------------
# POSTGRESQL — Configuración de la base de datos
# Estos valores los usa directamente la imagen oficial postgres:16-alpine.
# -----------------------------------------------------------------------------

POSTGRES_DB=sga_db
POSTGRES_USER=sga_user
POSTGRES_PASSWORD=<CAMBIAR_por_una_contraseña_segura>


# -----------------------------------------------------------------------------
# BACKEND — Variables de FastAPI
# DATABASE_URL debe coincidir exactamente con las credenciales de arriba.
# El host es "postgres" (nombre del servicio en docker-compose, no localhost).
# -----------------------------------------------------------------------------

DATABASE_URL=postgresql+psycopg2://sga_user:<CAMBIAR_por_una_contraseña_segura>@postgres:5432/sga_db

# Genera una clave segura con:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=<CAMBIAR_genera_una_clave_larga_aleatoria>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Orígenes CORS permitidos (separados por coma, sin espacios).
# Con Docker + Nginx reverse proxy el origen del navegador es localhost:80.
# Si usas un dominio propio en producción, reemplaza aquí.
CORS_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1


# -----------------------------------------------------------------------------
# FRONTEND — Variables de Vite (grabadas en el bundle durante el build)
# Con Nginx reverse proxy: usar ruta relativa /api/sga
#   → el navegador envía a  localhost:80/api/sga
#   → Nginx lo redirige a   backend:8000/api/sga
# Así no hay cambio de origen y CORS no es necesario para el navegador.
# -----------------------------------------------------------------------------

VITE_API_URL=/api/sga
