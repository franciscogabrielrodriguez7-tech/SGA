# Copia este archivo como ".env" (sin ".example") y ajusta los valores.
# NO subas el archivo ".env" real a un repositorio público.

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/sga_db

# NUEVO respecto a la variante sin JWT.
# Genera un valor aleatorio largo para producción, por ejemplo con:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=cambia-esto-por-una-clave-secreta-larga-y-aleatoria

JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
