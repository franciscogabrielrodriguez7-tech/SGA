# =============================================================================
# .dockerignore — Frontend SGA (React + Vite)
# Evita incluir archivos innecesarios en el contexto de build de Docker.
# =============================================================================

# Dependencias — se instalan dentro del contenedor con npm ci
node_modules/

# Build anterior — Vite lo genera de nuevo en el contenedor
dist/

# Archivos de secretos
.env
.env.*
!.env.example

# Cache de desarrollo
.vite/
*.local

# Control de versiones
.git/
.gitignore

# Documentación y archivos del proyecto no necesarios en runtime
*.md
LICENSE

# IDEs
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
